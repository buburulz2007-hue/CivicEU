    <string name="guide_title">EU Whistleblower Rights &amp; Guide</string>
    <string name="guide_subtitle">Learn your legal rights under EU Directive 2019/1937 and how to stay safe in real life.</string>
    <string name="rights_section_title">Your Legal Rights (EU Directive 2019/1937)</string>
    <string name="right_1_title">1. Absolute Protection Against Retaliation</string>
    <string name="right_1_desc">Dismissal, demotion, harassment, or financial penalties at work due to reporting are strictly prohibited by law.</string>
    <string name="right_2_title">2. Secure Reporting Channels</string>
    <string name="right_2_desc">You have the right to report internally, externally to authorities, or publicly to press and NGOs.</string>
    <string name="right_3_title">3. Legal Exemption from Liability</string>
    <string name="right_3_desc">You cannot be sued for breaching professional or trade secrecy when reporting in the public interest.</string>
    <string name="right_4_title">4. Guaranteed Confidentiality &amp; Anonymity</string>
    <string name="right_4_desc">Your identity will never be disclosed without your explicit consent at any stage of the investigation.</string>
    <string name="safety_section_title">Real-Life Safety &amp; Security Guide (OpSec)</string>
    <string name="tip_1_title">Separate Work Network and Devices</string>
    <string name="tip_1_desc">Never use your work laptop, work phone, company email, or office Wi-Fi to submit a report.</string>
    <string name="tip_2_title">Encryption &amp; Metadata Removal</string>
    <string name="tip_2_desc">Use in-app E2EE features and automatic EXIF removal to prevent identification through photos or files.</string>
    <string name="tip_3_title">Do Not Discuss Reports with Colleagues</string>
    <string name="tip_3_desc">Maintain complete discretion. Do not mention to anyone at work that you submitted a report.</string>
    <string name="tip_4_title">Keep Credentials in a Secure Place</string>
    <string name="tip_4_desc">Store your unique tracking code and secret passcode in a password manager or encrypted note.</string>
    <string name="whistleblower_guide_button">Whistleblower Rights Guide</string>

